PORT=3000
# Your deployed HTTPS origin, without a trailing slash. Required behind a proxy.
PUBLIC_ORIGIN=http://localhost:3000
# Keep uploads on persistent, private storage. This folder is never served directly.
UPLOAD_DIR=./var/community
# Mail.com SMTP access must be enabled for this mailbox; use an app-specific password with 2FA.
SMTP_HOST=smtp.mail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=htafl@africamail.com
SMTP_FROM=htafl@africamail.com
SMTP_PASS=
# Only set this if your host supplies exactly this many trusted proxy hops.
TRUST_PROXY_HOPS=0
# Run npm run backend:setup to set a private passphrase; never store a plain password.
ADMIN_USERNAME=htaflco
ADMIN_PASSWORD_HASH=
COMMUNITY_REVIEWER=HTAFL owner
# Use production on the public HTTPS host (admin cookies then require HTTPS).
NODE_ENV=development
