{
  "participate": {
    "title": "Find your way to take part.",
    "description": "Tell us what interests you and how you prefer to participate. This starts a conversation; it does not reserve an event place.",
    "submit": "Send participation enquiry",
    "fields": [
      {
        "name": "name",
        "label": "Name",
        "type": "text",
        "min": 1,
        "max": 100
      },
      {
        "name": "email",
        "label": "Email",
        "type": "email",
        "min": 3,
        "max": 254
      },
      {
        "name": "participationArea",
        "label": "Where would you like to start?",
        "type": "select",
        "required": true,
        "options": [
          [
            "creative-practice",
            "Creative practice"
          ],
          [
            "movement-resilience",
            "Movement and resilience"
          ],
          [
            "community-connection",
            "Community connection"
          ],
          [
            "exploring",
            "I’m still exploring"
          ]
        ]
      },
      {
        "name": "participationFormat",
        "label": "How do you prefer to take part? (optional)",
        "type": "select",
        "required": false,
        "options": [
          [
            "online",
            "Online"
          ],
          [
            "in-person",
            "In person"
          ],
          [
            "either",
            "Either"
          ],
          [
            "unsure",
            "Not sure yet"
          ]
        ]
      },
      {
        "name": "message",
        "label": "What would you like to try or ask about?",
        "type": "textarea",
        "min": 20,
        "max": 2000
      }
    ]
  },
  "create": {
    "title": "Bring your creative practice.",
    "description": "Share an idea, introduce your practice or ask about a creative collaboration. You can submit images separately through the community page.",
    "submit": "Send creative enquiry",
    "fields": [
      {
        "name": "name",
        "label": "Name or creator name",
        "type": "text",
        "min": 1,
        "max": 100
      },
      {
        "name": "email",
