            "fashion",
            "Fashion and personal style"
          ],
          [
            "illustration",
            "Illustration and sketching"
          ],
          [
            "upcycling",
            "Textiles and upcycling"
          ],
          [
            "photography",
            "Photography"
          ],
          [
            "mixed",
            "Mixed creative practice"
          ],
          [
            "other",
            "Another practice"
          ]
        ]
      },
      {
        "name": "creativeGoal",
        "label": "What would you like to do?",
        "type": "select",
        "required": true,
        "options": [
          [
            "share-work",
            "Share my work"
          ],
          [
            "develop-idea",
            "Develop an idea"
          ],
          [
            "collaborate",
            "Create with others"
          ]
        ]
      },
      {
        "name": "portfolio",
        "label": "Portfolio or social URL (optional)",
        "type": "url",
        "min": 0,
        "max": 2048
      },
      {
        "name": "projectStage",
        "label": "Where are you with your idea?",
        "type": "select",
        "required": true,
        "options": [
          [
            "idea",
            "An idea I want to explore"
          ],
          [
            "in-progress",
            "A work in progress"
          ],
          [
            "finished",
            "A finished piece"
          ],
          [
            "exploring",
            "Still finding my medium"
          ]
        ]
      },
      {
        "name": "message",
        "label": "Tell us about your work or idea",
        "type": "textarea",
        "min": 20,
        "max": 2000
      }
    ]
  },
