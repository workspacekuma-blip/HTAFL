{
  "brand": {
    "name": "HTAFL",
    "tagline": "Create. Overcome. Connect.",
    "concept": "HTAFL letter monogram (primary); Five-Path Mark (secondary motif)",
    "source": "Approved HTAFL Brand & Website UI Master / Figma ByICC8Kylyu2LGDRgjL3hT"
  },
  "colors": {
    "ink": {
      "hex": "#0B0B0C",
      "role": "secondary ink"
    },
    "cobalt": {
      "hex": "#3157FF",
      "role": "focus and link accent"
    },
    "coral": {
      "hex": "#D6C1A7",
      "role": "legacy alias of champagne"
    },
    "paper": {
      "hex": "#F7F4EC",
      "role": "primary light background"
    },
    "mist": {
      "hex": "#8B9AAF",
      "role": "legacy alias of gray-blue"
    },
    "slate": {
      "hex": "#101A33",
      "role": "legacy alias of navy"
    },
    "white": {
      "hex": "#F7F4EC",
      "role": "legacy inverse-text alias of ivory"
    },
    "success": {
      "hex": "#137A5B",
      "role": "success status"
    },
    "warning": {
      "hex": "#A85D00",
      "role": "warning status"
    },
    "danger": {
      "hex": "#B42318",
      "role": "error status"
    },
    "navy": {
      "hex": "#101A33",
      "role": "primary text, buttons and dark surfaces"
    },
    "champagne": {
      "hex": "#D6C1A7",
      "role": "restrained accents and dividing lines"
    },
    "gray-blue": {
      "hex": "#8B9AAF",
      "role": "supporting brand color"
    },
    "retail-black": {
      "hex": "#000000",
      "role": "owner-requested retail footer"
    },
    "retail-white": {
      "hex": "#FFFFFF",
      "role": "retail foregrounds and header"
    },
    "retail-blue": {
      "hex": "#051A6E",
      "role": "owner-requested deep-blue CTA and retail accents"
    }
  },
  "typography": {
    "display": {
      "family": "Space Grotesk",
      "fallback": "Arial, sans-serif",
      "weights": [
        500
      ],
      "variableRange": [
        300,
        700
      ]
    },
    "body": {
      "family": "Inter",
      "fallback": "Arial, sans-serif",
      "weights": [
        400,
        500,
        600,
        700
      ]
    },
    "scale": {
      "display-xl": "clamp(3.5rem, 8vw, 7.5rem)",
      "h1": "clamp(2.25rem, 4.2vw, 3.5rem)",
      "h2": "clamp(1.75rem, 3.2vw, 2.75rem)",
      "h3": "1.5rem",
      "body-lg": "clamp(1.125rem, 1.4vw, 1.375rem)",
      "body": "1rem",
      "small": "0.875rem"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem",
    "32": "8rem"
  },
  "radius": {
    "sm": "4px",
    "md": "4px",
    "lg": "4px",
    "pill": "999px"
  },
  "shadow": {
    "soft": "0 12px 40px rgba(17,24,39,0.10)",
    "focus": "0 0 0 4px rgba(49,87,255,0.28)"
  },
  "motion": {
    "fast": "160ms",
    "base": "240ms",
    "slow": "420ms",
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "layout": {
    "max": "1296px",
    "reading": "720px",
    "gutter": "clamp(20px, 5vw, 72px)"
  },
  "socialColors": {
    "scope": "CSS presentation for existing licensed platform glyphs; not HTAFL core colors",
    "instagram": [
      "#FEDA75",
      "#FA7E1E",
      "#D62976",
      "#962FBF",
      "#4F5BD5"
    ],
    "tiktok": [
      "#25F4EE",
