{
  "name": "htafl-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node server/build-site.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "review": "node --env-file-if-exists=.env server/review.js",
    "backend:setup": "node server/setup.js",
    "email:setup": "node server/email-setup.js",
    "email:test": "node --env-file-if-exists=.env server/test-submission.js",
    "backend:check": "node --env-file-if-exists=.env server/check.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "express": "5.2.1",
    "multer": "2.4.0",
    "nodemailer": "10.0.15",
    "serverless-http": "4.0.0",
    "sharp": "0.35.5"
  }
}
